[
  {
    "database": "ads_cockpit_freedom",
    "title": "商策自由查 NL2SQL 语义层文档",
    "source_md": "/home/zhou/myreport/semantic/private.tgw.dmall-os.cn/ads_cockpit_freedom.md",
    "semantics": {
      "purpose": "**用途**: 零售门店商品销售、供应链、库存、贸易质检等业务分析。",
      "units": "money_in_cents",
      "default_priority": [
        "semantic_doc",
        "metric_definitions",
        "realtime_schema",
        "model_knowledge"
      ],
      "forbidden_patterns": [
        "invent_columns",
        "mix_taxed_and_untaxed",
        "avg_of_ratios",
        "count_bitmap_with_count_star",
        "sum_snapshot_across_time"
      ],
      "semi_additive_metrics": [
        {
          "fields": ["begin_*", "opening_*", "end_*", "closing_*", "*_stock_*"],
          "non_additive_dimension": "dt",
          "opening_rule": "start-day opening field, otherwise latest closing snapshot before start",
          "closing_rule": "latest closing snapshot on or before end"
        }
      ],
      "join_rules": [
        "ads_cockpit_fd_store_ware_d / ads_cockpit_fd_store_ware_trade_qc_d_v5 / ads_cockpit_fd_supply_ware_d use group_id, store_code, matnr, supplier_code, sell_type",
        "ads_fd_dim_store_ware join key: group_id, store_code, matnr",
        "ads_fd_dim_supplier join key: group_id, supplier_code",
        "trade_qc bitmap fields must use BITMAP_COUNT"
      ],
      "default_filters": [
        "exclude_flag != 1",
        "service_flag != 1 OR service_flag IS NULL",
        "shopping_bag_flag != 1 OR shopping_bag_flag IS NULL"
      ],
      "metrics": [
        {
          "name": "销售额",
          "field": "actual_sale_untaxed_amt",
          "unit": "cent",
          "default_formula": "SUM(actual_sale_untaxed_amt)"
        },
        {
          "name": "毛利额",
          "field": "gp_untaxed_amt",
          "unit": "cent",
          "default_formula": "SUM(gp_untaxed_amt)"
        },
        {
          "name": "订单数",
          "field": "order_id_normal",
          "unit": "count",
          "default_formula": "BITMAP_COUNT(order_id_normal)"
        }
      ],
      "dimensions": [
        {
          "name": "门店",
          "fields": [
            "store_code",
            "store_name"
          ]
        },
        {
          "name": "商品",
          "fields": [
            "matnr",
            "ware_name",
            "item_num"
          ]
        },
        {
          "name": "供应商",
          "fields": [
            "supplier_code",
            "supplier_name"
          ]
        },
        {
          "name": "类目",
          "fields": [
            "purchase_category1~5",
            "operation_category1~5"
          ]
        },
        {
          "name": "预警",
          "fields": [
            "extra_stock",
            "low_stock",
            "lack_stock",
            "stasis_sales",
            "negative_profit"
          ]
        }
      ]
    }
  },
  {
