# ============================================
# Custom Report System — 生产环境配置文件
# ============================================
# 使用方法:
#   cp .env.example .env
#   然后修改所有占位值，特别关注 SECRET_KEY 和 PASSWORD_ENCRYPTION_KEY
# ============================================

# ---- 数据库 ----
# 生产环境建议使用 PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/myreport

# ---- Redis（必须） ----
# 缓存、任务队列、限流依赖 Redis
REDIS_URL=redis://localhost:6379/0

# ---- JWT / 安全 ----
# 务必修改！生成命令: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
# Token 过期时间（分钟），生产建议 30-60
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据源密码加密密钥 ----
# 务必修改！生成命令: openssl rand -hex 32
PASSWORD_ENCRYPTION_KEY=

# ---- 应用 ----
APP_NAME=Custom Report System
APP_VERSION=1.0.0
# 生产环境务必设为 False
DEBUG=False

# ---- CORS ----
# 前端部署地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

# ---- 限流 ----
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ---- 预测（可选） ----
# 启用销售预测功能
PREDICTION_ENABLED=False
PREDICTION_MODEL_DIR=./models/prediction
PREDICTION_TRAIN_DEFAULT_DAYS=365
PREDICTION_FORECAST_DAYS=30
PREDICTION_MIN_HISTORY_DAYS=90
PREDICTION_RETRAIN_CRON=0 2 * * *

# ---- NL2SQL / LLM ----
# 调用适配器: raw, langchain
LLM_ADAPTER=langchain
# 提供商: openai, azure, ollama, anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_API_BASE=https://api.openai.com/v1
# API 模式: chat, responses
LLM_API_MODE=chat

# Azure OpenAI（可选）
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Ollama 本地模型（可选）
# OLLAMA_BASE_URL=http://localhost:11434

# NL2SQL 行为
NL2SQL_TEMPERATURE=0.0
NL2SQL_MAX_RETRIES=2
NL2SQL_TIMEOUT=300
NL2SQL_CACHE_TTL=3600
NL2SQL_SCHEMA_RETRIEVAL_ENABLED=True
NL2SQL_SCHEMA_RETRIEVAL_MIN_CHARS=12000
NL2SQL_SCHEMA_RETRIEVAL_MAX_SECTIONS=8
