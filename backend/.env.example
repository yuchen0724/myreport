# ============================================
# Custom Report System — 环境配置模板
# ============================================
# 使用方法:
#   cp .env.example .env
#   然后修改所有占位值，特别是下列「必须修改」的配置项
# ============================================
# ⚠️  安全警告
# - 不要将 .env 文件提交到 Git
# - 不要在任何环境共享同一个 SECRET_KEY
# - 定期轮换 LLM_API_KEY 和 PASSWORD_ENCRYPTION_KEY
# ============================================

# ---- 数据库 ----
# 生产环境建议使用 PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/myreport

# ---- Redis（必须） ----
# 缓存、任务队列、限流依赖 Redis
REDIS_URL=redis://localhost:6379/0

# ---- 报表投递（按需配置） ----
FEISHU_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
EXPORT_MAX_ROWS=100000
PDF_EXPORT_MAX_ROWS=10000
EXPORT_QUERY_TIMEOUT_SECONDS=300

# ---- JWT / 安全（必须修改） ----
# 生成命令: openssl rand -hex 32
# 每个环境使用不同的密钥！
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256
# Token 过期时间（分钟），生产建议 30-60
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据源密码加密密钥（强烈建议修改） ----
# 如果留空，系统会从 SECRET_KEY 派生一个备用密钥（仅开发环境可用）。
# 生产环境必须设置！必须是 Fernet 兼容 key。
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENCRYPTION_KEY=

# ---- 应用 ----
APP_NAME=Custom Report System
APP_VERSION=1.0.0
# 生产环境务必设为 False
DEBUG=False

# ---- CORS ----
# 前端部署地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173
# 生产环境 CORS 白名单（优先级高于 CORS_ORIGINS）
# CORS_ORIGINS_PROD=https://report.mycompany.com

# ---- 限流 ----
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ---- 预测（可选） ----
PREDICTION_ENABLED=False
PREDICTION_MODEL_DIR=./models/prediction
PREDICTION_TRAIN_DEFAULT_DAYS=365
PREDICTION_FORECAST_DAYS=30
PREDICTION_MIN_HISTORY_DAYS=90
PREDICTION_RETRAIN_CRON=0 2 * * *

# ---- NL2SQL / LLM（必须修改） ----
# 调用适配器: raw, langchain
LLM_ADAPTER=langchain
# 提供商: openai, azure, ollama, anthropic
LLM_PROVIDER=openai
# ⚠️ 必须设置！此密钥有调用额度限制，请妥善保管
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_API_BASE=https://api.openai.com/v1
# API 模式: chat（chat.completions）或 responses（OpenAI Responses API）
LLM_API_MODE=chat

# Azure OpenAI（可选）
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Ollama 本地模型（可选）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# NL2SQL 行为
NL2SQL_TEMPERATURE=0.0
NL2SQL_MAX_RETRIES=2
NL2SQL_TIMEOUT=300
NL2SQL_CACHE_TTL=3600
NL2SQL_SCHEMA_RETRIEVAL_ENABLED=True
NL2SQL_SCHEMA_RETRIEVAL_MIN_CHARS=12000
NL2SQL_SCHEMA_RETRIEVAL_MAX_SECTIONS=8
# 提示词模板（默认使用外部文档）
NL2SQL_SYSTEM_PROMPT_PATH=prompts/nl2sql/system_prompt.md
NL2SQL_REPAIR_PROMPT_PATH=prompts/nl2sql/repair_prompt.md
